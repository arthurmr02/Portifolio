# Copie este arquivo para .env e preencha. O .env nunca vai para o Git.
# Todas as variaveis VITE_* ficam visiveis no navegador: nao coloque segredos aqui.

# Dono do portfolio
VITE_OWNER_NAME=Arthur
VITE_OWNER_ROLE=Desenvolvedor front-end
VITE_OWNER_EMAIL=voce@exemplo.com
VITE_GITHUB_USERNAME=seu-usuario-github
# Repositorios que nao devem aparecer, separados por virgula (ex.: o repo do perfil)
VITE_EXCLUDED_REPOS=

# Supabase (Project Settings > API). Use a chave publica "anon"/"publishable".
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon

# Formspree (e-mail para o dono). Crie um form em formspree.io e cole o ID.
VITE_FORMSPREE_FORM_ID=seu-id-do-form

# Usadas apenas pelos MCPs do harness de IA (.mcp.json). Nao sao lidas pelo app.
# GITHUB_PERSONAL_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
